---
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
// Other font pairings from Appearance. Browsers only download the fonts a page actually uses.
import '@fontsource/newsreader/400.css';
import '@fontsource/newsreader/500.css';
import '@fontsource/newsreader/600.css';
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/500.css';
import '@fontsource/nunito/600.css';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import { PUBLIC, readSingle } from '../../../schema/read.js';
import { themeCss, themeColors } from '../../../schema/theme.js';
import { siteBase } from '../../../schema/content.js';

const { settings, title, description, noindex = false, path = '/', jsonld = null } = Astro.props;
const pageTitle = title ?? settings.title;
const pageDesc = description ?? settings.description;
// Links for search engines and share previews must be full addresses, so they're left out until the site has one.
const base = siteBase(settings);
const ogImage = base && existsSync(join(PUBLIC, 'og.png')) ? `${base}/og.png` : null;
// The owner's look from Appearance: colours and fonts as CSS variables, layout choices as attributes.
const theme = readSingle('theme');
const colors = themeColors(theme);
---
<!doctype html>
<html lang="en" data-layout={theme.layout} data-photo={theme.photo} data-density={theme.density}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    {pageDesc && <meta name="description" content={pageDesc} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {base && <link rel="canonical" href={`${base}${path}`} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    {pageDesc && <meta property="og:description" content={pageDesc} />}
    {base && <meta property="og:url" content={`${base}${path}`} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {theme.mode === 'auto'
      ? <><meta name="theme-color" content={colors.light.bg} media="(prefers-color-scheme: light)" /><meta name="theme-color" content={colors.dark.bg} media="(prefers-color-scheme: dark)" /></>
      : <meta name="theme-color" content={theme.mode === 'dark' ? colors.dark.bg : colors.light.bg} />}
    <style is:inline set:html={themeCss(theme)}></style>
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld).replaceAll('<', '\u003c')} />}
  </head>
  <body>
    <slot />
    {import.meta.env.DEV && (
      <script is:inline>
        // CMS preview only (never in the published site): try unsaved Appearance choices live.
        window.addEventListener('message', function (e) {
          var d = e.data;
          if (!d || d.type !== 'portfolio-theme' || !/^https?:\/\/(127\.0\.0\.1|localhost)(:\d+)?$/.test(e.origin)) return;
          var s = document.getElementById('theme-live');
          if (!s) {
            s = document.createElement('style');
            s.id = 'theme-live';
            document.head.appendChild(s);
          }
          s.textContent = d.css;
          Object.keys(d.attrs || {}).forEach(function (k) { document.documentElement.setAttribute('data-' + k, d.attrs[k]); });
        });
        // CMS preview only (never in the published site): outline what's being edited.
        (function () {
          var key = new URLSearchParams(location.search).get('hl');
          if (!key) return;
          var el = document.querySelector('[data-hl="' + CSS.escape(key) + '"]');
          if (!el) return;
          el.style.outline = '3px solid var(--accent)';
          el.style.outlineOffset = '8px';
          el.style.borderRadius = '2px';
          el.scrollIntoView({ block: 'center' });
        })();
      </script>
    )}
  </body>
</html>
